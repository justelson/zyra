        "typescript": "^5.7.3",
        "vite": "^5.4.11",
        "vite-plugin-static-copy": "^3.1.4"
    },
    "build": {
        "appId": "app.zyra.desktop",
        "productName": "Zyra",
        "copyright": "Copyright © 2026 justelson",
        "afterPack": "scripts/release/widevine-vmp-after-pack.cjs",
        "afterSign": "scripts/release/widevine-vmp-after-sign.cjs",
        "icon": "resources/icon.png",
        "asar": true,
        "electronFuses": {
            "runAsNode": true,
            "enableCookieEncryption": true,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": true,
            "onlyLoadAppFromAsar": true
        },
        "files": [
            "!dist/**",
            "!.release/**",
            "!resources/branding/icons/*-source.png"
        ],
        "asarUnpack": [
            "node_modules/node-pty/**"
        ],
        "npmRebuild": false,
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "../LICENSE",
                "to": "LICENSE"
            },
            {
                "from": "../NOTICE",
                "to": "NOTICE"
            },
            {
                "from": "../THIRD_PARTY_NOTICES.md",
                "to": "THIRD_PARTY_NOTICES.md"
            },
            {
                "from": "../THIRD_PARTY_LICENSES.txt",
                "to": "THIRD_PARTY_LICENSES.txt"
            },
            {
                "from": ".release/zyra-runtime",
                "to": "zyra-runtime",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": ".release/zyra-runtime/node_modules",
                "to": "zyra-runtime/node_modules",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": ".release/zyra-node",
                "to": "zyra-node",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../extensions/zyra-browser-control/dist/unpacked",
                "to": "zyra-browser-control-extension",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "electronDownload": {
            "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "justelson",
                "repo": "zyra"
            }
        ],
        "generateUpdatesFilesForAllChannels": true,
        "fileAssociations": [
            {
                "name": "Zyra Code and Text Preview",
                "description": "Preview code and text with Zyra",
                "role": "Viewer",
                "icon": "resources/icon",
                "ext": [
                    "md",
                    "markdown",
                    "mdx",
                    "txt",
                    "log",
                    "js",
                    "jsx",
                    "mjs",
                    "cjs",
                    "ts",
                    "tsx",
                    "json",
                    "jsonc",
                    "json5",
                    "css",
                    "scss",
                    "less",
                    "html",
                    "htm",
                    "xml",
                    "yml",
                    "yaml",
                    "toml",
                    "ini",
                    "conf",
                    "sh",
                    "bash",
                    "zsh",
                    "ps1",
                    "bat",
                    "cmd",
                    "py",
                    "rb",
                    "php",
                    "java",
                    "kt",
                    "kts",
                    "c",
                    "h",
                    "cpp",
                    "cxx",
                    "hpp",
                    "cs",
                    "go",
                    "rs",
                    "swift",
                    "dart",
                    "scala",
                    "sql",
                    "vue",
                    "svelte",
                    "gradle",
                    "lua",
                    "r",
                    "pl",
                    "pm",
                    "clj",
                    "cljs",
                    "ex",
                    "exs",
                    "erl",
                    "fs",
                    "fsx",
                    "vb",
                    "vbs",
                    "asm",
                    "s",
                    "sol",
                    "proto",
                    "graphql",
                    "gql",
                    "tf",
                    "tfvars",
                    "hcl",
                    "nix",
                    "cmake",
                    "hbs",
                    "pug",
                    "coffee",
                    "cfg",
                    "config",
                    "properties",
                    "prefs",
                    "lock",
                    "diff",
                    "patch",
                    "pem",
                    "crt",
                    "cer",
                    "srt",
                    "vtt"
                ]
            },
            {
                "name": "Zyra Document Preview",
                "description": "Preview documents and workbooks with Zyra",
                "role": "Viewer",
                "icon": "resources/icon",
                "ext": [
                    "pdf",
                    "docx",
                    "xlsx",
                    "pptx",
                    "csv",
                    "tsv"
                ]
            },
            {
                "name": "Zyra Image Preview",
                "description": "Preview images with Zyra",
                "role": "Viewer",
                "icon": "resources/icon",
                "ext": [
                    "png",
                    "jpg",
                    "jpeg",
                    "gif",
                    "svg",
                    "webp",
                    "ico",
                    "bmp",
                    "avif"
                ]
            },
            {
                "name": "Zyra Media Preview",
                "description": "Preview video and audio with Zyra",
                "role": "Viewer",
                "icon": "resources/icon",
                "ext": [
                    "mp4",
                    "webm",
                    "ogg",
                    "mov",
                    "avi",
                    "mkv",
                    "m4v",
                    "mp3",
                    "wav",
                    "m4a",
                    "aac",
                    "flac",
                    "oga",
                    "opus"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Zyra-Desktop-${version}-Windows-${arch}.${ext}",
            "icon": "resources/icon.ico",
            "extraResources": [
                {
                    "from": ".release/zyra-computer-use/win-x64",
                    "to": "zyra-computer-use",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "include": "build/installer.nsh",
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "differentialPackage": true
        },
        "mac": {
            "extraResources": [
                {
                    "from": "node_modules/electron/dist/LICENSE",
                    "to": "ELECTRON-LICENSE.txt"
                },
                {
                    "from": "node_modules/electron/dist/LICENSES.chromium.html",
                    "to": "CHROMIUM-THIRD-PARTY-LICENSES.html"
                }
            ],
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "artifactName": "Zyra-Desktop-${version}-macOS-${arch}.${ext}",
            "x64ArchFiles": "Contents/Resources/{zyra-runtime/node_modules/**,app.asar.unpacked/node_modules/node-pty/prebuilds}/*darwin-{arm64,x64}*/**/*",
            "icon": "resources/icon.icns",
            "category": "public.app-category.developer-tools",
            "hardenedRuntime": true,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.inherit.plist",
            "gatekeeperAssess": false,
            "notarize": false,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Zyra uses the microphone only when you start a voice conversation or transcription."
            }
        },
        "dmg": {
            "sign": false
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Zyra-Desktop-${version}-Linux-x64.${ext}",
            "icon": "resources/icons",
            "category": "Development",
            "maintainer": "Zyra",
            "synopsis": "Local Zyra coding assistant desktop application"
        }
    },
    "homepage": "https://github.com/justelson/zyra",
    "overrides": {
        "js-yaml": "4.3.1",
        "uuid": "11.1.1",
        "dompurify": "3.4.14"
    }
}
