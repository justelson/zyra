        "maint:loc:strict": "node scripts/maint/check-loc.mjs --strict",
        "postinstall": "node scripts/maint/apply-legend-list-scroll-patch.mjs && node scripts/maint/ensure-electron.mjs && node scripts/release/verify-node-pty-install.mjs",
