    "build": {
        "appId": "app.zyra.desktop",
        "productName": "Zyra",
        "copyright": "Copyright © 2026 justelson",
        "beforePack": "scripts/release/windows-file-icons-before-pack.cjs",
        "afterPack": "scripts/release/widevine-vmp-after-pack.cjs",
        "afterSign": "scripts/release/widevine-vmp-after-sign.cjs",
        "icon": "resources/icon.png",
        "asar": true,
        "electronFuses": {
            "runAsNode": true,
            "enableCookieEncryption": true,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": true,
            "onlyLoadAppFromAsar": true
        },
        "files": [
            "!dist/**",
            "!.release/**",
            "!resources/branding/icons/*-source.png"
        ],
        "asarUnpack": [
            "node_modules/node-pty/**"
        ],
        "npmRebuild": false,
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "../LICENSE",
