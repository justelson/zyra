    "devDependencies": {
        "@types/node": "^22.10.5",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^5.1.0",
        "autoprefixer": "^10.4.20",
        "electron": "https://github.com/castlabs/electron-releases/archive/refs/tags/v43.2.0%2Bwvcus.tar.gz",
        "electron-builder": "26.15.3",
        "electron-vite": "^2.3.0",
