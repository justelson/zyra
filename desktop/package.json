        "node-pty": "1.1.0",
        "ogl": "^1.0.11",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "7.18.3",
        "react-syntax-highlighter": "^16.1.0",
        "recharts": "^3.6.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "simple-git": "3.36.0",
        "sql.js": "^1.13.0",
