{
  "name": "@zyra/browser-control-extension",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node scripts/build.mjs --controls-only && node --test tests/*.test.mjs && npm run test:cursor-page",
    "test:cursor": "node --test tests/cursor.test.mjs tests/branding.test.mjs",
    "test:cursor-page": "node tests/cursor-page.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:cursor": "tsc --noEmit -p tsconfig.cursor.json"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@types/chrome": "0.0.287",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "typescript": "5.9.3"
  }
}
